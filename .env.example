# ============================================================================
# Pulsedeck · Telegram 快讯聚合 · 环境变量示例
# ----------------------------------------------------------------------------
# 说明：Vercel 生产环境【不会】自动读取 .env.local，请在本仓库的
#       Vercel 控制台 → Settings → Environment Variables 中逐项添加，
#       然后重新部署（或等 Cron 预热）即可生效。
#       本地用 `node scripts/dev-server.js` 调试时，可复制本文件为 .env.local。
# ============================================================================

# Telegram 免登录 Web 预览页基址（默认 https://t.me/s，零成本、绝对不会 403）
# 直接解析 t.me/s/<username> 页面，无需 RSSHub。一般保持默认即可；
# 如需指向自建镜像可改此值（结尾不要带 /）。
TG_WEB_BASE_URL=https://t.me/s

# DeepSeek / OpenAI 兼容接口密钥（留空则跳过 AI 审验，直接使用原文摘要）
DEEPSEEK_API_KEY=

# DeepSeek / OpenAI 兼容接口 Base URL（结尾是否带 /v1 以服务商文档为准）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：自定义模型名（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# Vercel Cron 预热校验密钥（vercel.json 中配置了每小时触发 /api/telegram）
# 设置后，Cron 请求须携带 Authorization: Bearer <本值> 或 ?secret=<本值> 才被接受
CRON_SECRET=
